# Safe default: mock prices + local Thai template + console. NO network calls.
MOCK_MODE=true
WATCHLIST_PATH=config/watchlist.json
# Keep mock/live databases separate. Relative paths resolve from project root.
MOCK_DATABASE_PATH=data/mock.sqlite3
LIVE_DATABASE_PATH=data/live.sqlite3
LOG_LEVEL=INFO
PRICE_DROP_PCT=5
PRICE_RISE_PCT=8
RSI_LOW=30
RSI_HIGH=70
COOLDOWN_HOURS=24

# Future live connection: leave empty until the mock workflow is approved.
STOCK_PROVIDER=twelvedata
STOCK_API_KEY=
# First round: 5-minute OHLC + daily history. Later: 5-minute OHLC only (daily cache).
# Minimum 8 seconds is enforced; persistent local cap is 760 credits/day UTC.
PROVIDER_REQUEST_INTERVAL_SECONDS=8
HISTORY_BARS=3000
HTTP_TIMEOUT_SECONDS=20
# Allows weekends; timestamps remain visible. Not a guarantee of real-time data.
MAX_QUOTE_AGE_HOURS=96
# Use the installed Codex CLI + your ChatGPT login. MOCK_MODE still forces template.
ANALYST_MODE=codex
CODEX_CLI_PATH=
# GPT-5.6 Terra defaults to medium reasoning effort. Keep this bounded model for reviews.
CODEX_MODEL=gpt-5.6-terra
CODEX_TIMEOUT_SECONDS=180
# Automatic alert analyses only; 0 disables AI calls but keeps template alerts.
AI_MAX_CALLS_PER_DAY=9
AI_MAX_CALLS_PER_STOCK_PER_DAY=1
# Manual/daily sync only; never called during the five-minute price check.
# /press_releases is an official-company-announcement feed, not general web news.
NEWS_MODE=press_releases
NEWS_LOOKBACK_DAYS=14
NEWS_PER_SYMBOL=3
NEWS_SYNC_MIN_HOURS=24
# Optional alternative: ANALYST_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Google Gemini alternative. It is not active unless ANALYST_MODE=gemini.
# The Free Tier may use submitted data to improve Google products; private portfolio
# context is excluded unless you explicitly opt in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SHARE_PORTFOLIO_CONTEXT=false
NOTIFIER_MODE=console
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_CHANNEL_SECRET=
# Proactive manager notifications; independent of price alerts, AI and market-data credits.
MANAGER_PUSH_LIMIT_PER_DAY=8
# Thai morning delivery for daily/weekly/monthly briefs, weekly news and DCA.
# If offline at that time, send the latest missed round after the next start.
MANAGER_DELIVERY_HOUR=10
# News/filing catch-up is bounded by the source feeds' seven-day history.
MANAGER_CATCHUP_DAYS=7
# SEC requires an identifying contact for automated public data requests.
SEC_CONTACT_EMAIL=
